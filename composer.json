{
    "name": "trilbdev/wikipress",
    "description": "A WordPress plugin that provides a comprehensive wiki management system, allowing users to create, manage, and display wiki content within their WordPress site.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "files": [
            "src/Includes/Plugins/PluginsInterface.php"
        ],
        "psr-4": {
            "WikiPress\\": "src/"
        },
        "classmap": [
            "src/WikiPress.php"
        ],
        "exclude-from-classmap": [
            "src/Includes/Plugins/"
        ]
    },
    "authors": [
        {
            "name": "Anthony Blüthner",
            "email": "mrtrilb@trilb.dev",
            "homepage": "https://trilb.dev"
        }
    ],
    "require": {
        
    },
    "require-dev": {
        "fortawesome/wordpress-fontawesome": "^5.2",
        "php-stubs/wordpress-stubs": "^6.9",
        "arts/elementor-stubs": "^4.2",
        "phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"wp-coding-standards/wpcs": "^3.4",
		"yoast/phpunit-polyfills": "^1.1",
		"yoast/wp-test-utils": "^1.2"
	},
	"scripts": {
		"test": "php ./vendor/bin/phpunit --configuration phpunit.xml.dist",
		"test:unit": "php ./vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite unit",
		"lint": "php ./vendor/bin/phpcs --standard=phpcs.xml.dist",
		"lint:docs": "php ./vendor/bin/phpcs --standard=WordPress-Docs --extensions=php src tests",
		"check": [
			"@test",
			"@lint",
			"@lint:docs"
		]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
